# Kopiera till .env och fyll i SJÄLV. .env läses automatiskt. Dela den aldrig.

# --- Aktier i paper-läge (gratis) ---
# Alpaca paper-konto: https://alpaca.markets  (kurser, kalender, och i testnet-läge även ordrar)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Finnhub free: https://finnhub.io  (earnings-kalender + bolagsnyheter)
FINNHUB_API_KEY=

# --- Testnet (börsernas testmiljöer, inga riktiga pengar) ---
# DESK_MODE=testnet
BINANCE_API_KEY_TESTNET=
BINANCE_API_SECRET_TESTNET=
BINANCE_FUTURES_API_KEY_TESTNET=
BINANCE_FUTURES_API_SECRET_TESTNET=

# --- Live (riktiga pengar). Bara trade-nycklar, UTTAG AVSTÄNGT, gärna IP-låst ---
# DESK_MODE=live
# DESK_LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Maskinspecifikt (valfritt, inga hemligheter) ---
# Om api.binance.com svarar 451 (geospärr, t.ex. molnservrar i USA): Binances publika
# speglingsadress för spot-marknadsdata.
# DESK_BINANCE_SPOT_DATA=https://data-api.binance.vision
# Stänger av perps och guld/silver. fapi.binance.com saknar spegling, så det behövs om även den svarar 451.
# DESK_PERPS_OFF=1
